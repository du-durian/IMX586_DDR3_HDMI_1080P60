module MIPI_Byte_to_Pixel_Converter_Top (
  I_RSTN,
  I_BYTE_CLK,
  I_PIXEL_CLK,
  I_SP_EN,
  I_LP_AV_EN,
  I_DT,
  I_WC,
  I_PAYLOAD_DV,
  I_PAYLOAD,
  O_FV,
  O_LV,
  O_PIXEL
)
;
input I_RSTN;
input I_BYTE_CLK;
input I_PIXEL_CLK;
input I_SP_EN;
input I_LP_AV_EN;
input [5:0] I_DT;
input [15:0] I_WC;
input [0:0] I_PAYLOAD_DV;
input [7:0] I_PAYLOAD;
output O_FV;
output O_LV;
output [7:0] O_PIXEL;
wire VCC;
wire GND;
  \~BYTE_TO_PIXEL.MIPI_Byte_to_Pixel_Converter_Top  u_b2p_inst (
    .I_BYTE_CLK(I_BYTE_CLK),
    .I_LP_AV_EN(I_LP_AV_EN),
    .I_PIXEL_CLK(I_PIXEL_CLK),
    .I_RSTN(I_RSTN),
    .I_SP_EN(I_SP_EN),
    .I_WC(I_WC[15:0]),
    .I_PAYLOAD(I_PAYLOAD[7:0]),
    .I_PAYLOAD_DV(I_PAYLOAD_DV[0]),
    .I_DT(I_DT[5:0]),
    .O_LV(O_LV),
    .O_FV(O_FV),
    .O_PIXEL(O_PIXEL[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* MIPI_Byte_to_Pixel_Converter_Top */
